--- !u!114 &851903815
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 851903814}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f0ed6670259b4541ab556b4253e3bd6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_triggerType: 0
  m_dialogue:
    sentences:
    - speakerName: Elder Kenji
      sentence: Bagus, refleks dan ayunan pedangmu sudah cukup matang untuk memulai
        perjalanan ini.
      speakerPortrait: {fileID: 21300000, guid: ebea21e07d29b7f41987d6eb60533a29,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Sial, mereka terlalu banyak.
      speakerPortrait: {fileID: 21300000, guid: e3dd86b05f0d5fe429a6349eac0cfab6,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Tapi aku tidak boleh menyerah, ini tentang bertahan atau mati.
      speakerPortrait: {fileID: 21300000, guid: 54b8778bd3288494e8cba71b27e18348,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Ingat, Alaric. Kegelapan di dalam dungeon ini tidak mengenal ampun.
        Jangan tinggalkan saksi jika kau ingin bertahan hidup
      speakerPortrait: {fileID: 21300000, guid: ebea21e07d29b7f41987d6eb60533a29,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Sebelum kau pergi ke dungeon. Gunakan lah ini.
      speakerPortrait: {fileID: 21300000, guid: ebea21e07d29b7f41987d6eb60533a29,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Apa ini?
      speakerPortrait: {fileID: 21300000, guid: 48b4d8615994cc1499351514d20406d3,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Ini adalah buffcard. Gunakan ini setiap kamu memulai lantai dungeon
        yang baru.
      speakerPortrait: {fileID: 21300000, guid: b142f96cf71a66a46a007de1b859bd35,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Kenapa...., kau begitu peduli terhadapku??
      speakerPortrait: {fileID: 21300000, guid: 48b4d8615994cc1499351514d20406d3,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Itu bukanlah hal yang penting sekarang, lanjutkan perjalanan mu sekarang
        Alaric.
      speakerPortrait: {fileID: 21300000, guid: aa4a57f3d21aa0c44a37f6f630f0e457,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: (Ini aneh, tapi dia benar. Aku tidak punya banyak waktu. Aku harus
        segera bergerak)
      speakerPortrait: {fileID: 21300000, guid: 48b4d8615994cc1499351514d20406d3,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Kau benar, terimakasih atas bantuan mu, aku akan menemukan kebenaran
        dari kejadian itu.
      speakerPortrait: {fileID: 21300000, guid: 54b8778bd3288494e8cba71b27e18348,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Bagus, masuklah ke portal di ujung sana. Perjalananmu yang sesungguhnya
        baru saja dimulai.
      speakerPortrait: {fileID: 21300000, guid: aa4a57f3d21aa0c44a37f6f630f0e457,
        type: 3}
      backgroundImage: {fileID: 0}
  m_interactPrompt: {fileID: 0}
  m_interactKey: 102
  OnDialogueComplete:
    m_PersistentCalls:
      m_Calls: []

--- !u!114 &427010065
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 427010063}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f0ed6670259b4541ab556b4253e3bd6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_triggerType: 0
  m_dialogue:
    sentences:
    - speakerName: Elder Kenji
      sentence: Ini adalah lantai terakhir sebelum memasuki dungeon. Di sini, kau
        akan mengasah ketajaman pedang dan refleksmu sebelum melangkah turun ke dungeon.
      speakerPortrait: {fileID: 21300000, guid: b142f96cf71a66a46a007de1b859bd35,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Aku siap. Ajarkan aku apa yang perlu kuketahui.
      speakerPortrait: {fileID: 21300000, guid: 54b8778bd3288494e8cba71b27e18348,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Bagus. Ingat, gunakan tombol WASD untuk bergerak, klik kiri untuk
        Menyerang, klik kanan untuk Bertahan (Block), dan tombol Space untuk Berguling
        (Roll).
      speakerPortrait: {fileID: 21300000, guid: ebea21e07d29b7f41987d6eb60533a29,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Sekarang, coba serang 2 skeleton di depanmu!
      speakerPortrait: {fileID: 21300000, guid: aa4a57f3d21aa0c44a37f6f630f0e457,
        type: 3}
      backgroundImage: {fileID: 0}
  m_interactPrompt: {fileID: 0}
  m_interactKey: 102
  OnDialogueComplete:
    m_PersistentCalls:
      m_Calls: []

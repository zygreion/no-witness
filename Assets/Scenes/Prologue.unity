--- !u!114 &791814851
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 791814850}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f0ed6670259b4541ab556b4253e3bd6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_triggerType: 1
  m_dialogue:
    sentences:
    - speakerName: Alaric
      sentence: Hah... Hah... Akhirnya aku sampai di area lapang ini. Sepertinya
        para pengejar itu benar-benar kehilangan jejakku.
      speakerPortrait: {fileID: 21300000, guid: e3dd86b05f0d5fe429a6349eac0cfab6,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Aku harus mencari tempat berteduh untuk memulihkan tenagaku. Tapi
        sebaiknya aku memeriksa sekeliling terlebih dahulu untuk memastikan tidak
        ada bahaya tersembunyi.
      speakerPortrait: {fileID: 21300000, guid: 9e487fb84e54da24d83a30fe2f91a7e5,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Tunggu... disana, sepertinya ada seseorang. Aku harus berhati-hati,
        dia bisa saja berbahaya.
      speakerPortrait: {fileID: 21300000, guid: 48b4d8615994cc1499351514d20406d3,
        type: 3}
      backgroundImage: {fileID: 0}
  m_interactPrompt: {fileID: 0}
  m_interactKey: 102
  OnDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 1274074512}
        m_TargetAssemblyTypeName: PlayerController, Assembly-CSharp
        m_MethodName: LockPlayerControl
        m_Mode: 6
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2

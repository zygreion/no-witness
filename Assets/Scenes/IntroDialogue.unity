  serializedVersion: 6
  m_Component:
  - component: {fileID: 451116390}
  - component: {fileID: 451116389}
  m_Layer: 0
  m_Name: SceneIntroDialogue
  m_TagString: Untagged
  m_Icon: {fileID: 0}
  m_NavMeshLayer: 0
  m_StaticEditorFlags: 0
  m_IsActive: 1
--- !u!114 &451116389
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 451116388}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f0ed6670259b4541ab556b4253e3bd6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_triggerType: 0
  m_dialogue:
    sentences:
    - speakerName: Alaric
      sentence: "Ini... mustahil. Tempat ini terbakar habis... dan semua rekanku...
        tiada.\r"
      speakerPortrait: {fileID: 21300000, guid: 0b5232f0efbf4b44f867f5d88ed3c4ff,
        type: 3}
      backgroundImage: {fileID: 21300000, guid: 48f0e670aeec06943a40a9f98ec948a1,
        type: 3}
    - speakerName: Alaric
      sentence: Tunggu, aku mendengar langkah kaki mendekat! Seseorang menuju kemari!
      speakerPortrait: {fileID: 21300000, guid: 0b5232f0efbf4b44f867f5d88ed3c4ff,
        type: 3}
      backgroundImage: {fileID: 21300000, guid: 48f0e670aeec06943a40a9f98ec948a1,
        type: 3}
    - speakerName: Alaric
      sentence: "Aku tidak boleh tertangkap di sini dengan tuduhan ini. Aku harus
        segera pergi!\r"
      speakerPortrait: {fileID: 21300000, guid: 0b5232f0efbf4b44f867f5d88ed3c4ff,
        type: 3}
      backgroundImage: {fileID: 21300000, guid: 48f0e670aeec06943a40a9f98ec948a1,
        type: 3}
    - speakerName: Alaric
      sentence: Hah... Hah... Kurasa... mereka akhirnya kehilangan jejakku di kegelapan
        hutan ini.
      speakerPortrait: {fileID: 21300000, guid: e3dd86b05f0d5fe429a6349eac0cfab6,
        type: 3}
      backgroundImage: {fileID: 21300000, guid: f23b4d7ae5502d74291254a738175553,
        type: 3}
    - speakerName: Alaric
      sentence: Hutan ini sunyi sekali. Di depan sana... sepertinya ada area lapang
        kosong yang cukup aman untuk berlindung.
      speakerPortrait: {fileID: 21300000, guid: e3dd86b05f0d5fe429a6349eac0cfab6,
        type: 3}
      backgroundImage: {fileID: 21300000, guid: f23b4d7ae5502d74291254a738175553,
        type: 3}
    - speakerName: Alaric
      sentence: Aku harus memulihkan tenagaku di sana dan mencari tahu siapa dalang
        sebenarnya di balik fitnah keji ini!
      speakerPortrait: {fileID: 21300000, guid: 4793042a1ff829640b004ffb4f9c9311,
        type: 3}
      backgroundImage: {fileID: 21300000, guid: f23b4d7ae5502d74291254a738175553,
        type: 3}
  m_interactPrompt: {fileID: 0}
  m_interactKey: 102
  OnDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 397759495}
        m_TargetAssemblyTypeName: SceneLoader, Assembly-CSharp
        m_MethodName: LoadScene
        m_Mode: 5
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: Prologue
          m_BoolArgument: 0
        m_CallState: 2

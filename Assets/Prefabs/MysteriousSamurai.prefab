--- !u!114 &6034617789052937486
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 6287910594963263232}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f0ed6670259b4541ab556b4253e3bd6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_triggerType: 0
  m_dialogue:
    sentences:
    - speakerName: Alaric
      sentence: '(Mengendap dari belakang, mengacungkan pedang)

        Jangan bergerak!
        Siapa kau sebenarnya dan apa maumu, atau kubunuh kau di sini!'
      speakerPortrait: {fileID: 21300000, guid: 4793042a1ff829640b004ffb4f9c9311,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: ???
      sentence: '(Tetap tenang tanpa berbalik arah)

        Heh... Anak muda, amarahmu
        terlalu berisik. Aku sudah tahu kau mengendap-endap di sana sejak melintasi
        gerbang luar.'
      speakerPortrait: {fileID: 21300000, guid: ebea21e07d29b7f41987d6eb60533a29,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: '(Terkejut, mempererat genggaman pedang)

        Jangan main-main!
        Cepat katakan siapa dirimu!'
      speakerPortrait: {fileID: 21300000, guid: 54b8778bd3288494e8cba71b27e18348,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: '(Berbalik perlahan)

        Panggil aku Kenji. Aku tahu apa yang
        kau cari, Alaric. Kebenaran di balik tragedi yang menimpamu... dan siapa
        dalang di balik semua ini.'
      speakerPortrait: {fileID: 21300000, guid: b142f96cf71a66a46a007de1b859bd35,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: Bagaimana kau bisa tahu namaku?! Dan apa maksudmu dengan 'kebenaran'?
      speakerPortrait: {fileID: 21300000, guid: 54b8778bd3288494e8cba71b27e18348,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Jawaban yang kau cari ada di dalam dungeon terdalam. Namun, melihat
        caramu memegang pedang... kau hanya akan mengantarkan nyawamu sia-sia ke
        monster di bawah sana.
      speakerPortrait: {fileID: 21300000, guid: ebea21e07d29b7f41987d6eb60533a29,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Elder Kenji
      sentence: Ikuti aku. Buktikan padaku bahwa kau layak memegang pedang itu. Setelah
        semuanya selesai, barulah kita bicara lagi.
      speakerPortrait: {fileID: 21300000, guid: b142f96cf71a66a46a007de1b859bd35,
        type: 3}
      backgroundImage: {fileID: 0}
    - speakerName: Alaric
      sentence: (Aku rasa aku tak punya pilihan selain mengikuti orang tua ini.)
      speakerPortrait: {fileID: 21300000, guid: 48b4d8615994cc1499351514d20406d3,
        type: 3}
      backgroundImage: {fileID: 0}
  m_interactPrompt: {fileID: 928042443881414056}
  m_interactKey: 102
  OnDialogueComplete:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 0}
        m_TargetAssemblyTypeName: SceneLoader, Assembly-CSharp
        m_MethodName: LoadScene
